{
  "schemaVersion": 1,
  "name": "four-pack",
  "description": "A specifier writes the specification and stops at a human approval gate, then a coder, a refactorer and an architect shape the change.",
  "toolchain": "node-ts",
  "approval": { "after": "specifier" },
  "roles": [
    { "id": "specifier", "agent": "swarm-specifier", "isolation": "master", "receive": "task", "propagation": "forward-only" },
    { "id": "coder", "agent": "swarm-coder", "isolation": "worktree", "receive": "task", "propagation": "forward-only" },
    { "id": "refactorer", "agent": "swarm-refactorer", "isolation": "worktree", "receive": "task", "propagation": "forward-only" },
    { "id": "architect", "agent": "swarm-architect", "isolation": "worktree", "receive": "task", "propagation": "forward-only" }
  ],
  "gates": {
    "coder": ["tests-green", "test-first", "coverage"],
    "refactorer": ["tests-green", "crap", "dry"],
    "architect": ["tests-green", "structure"]
  }
}
