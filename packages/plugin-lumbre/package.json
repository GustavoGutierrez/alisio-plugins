{
  "name": "@alisio/plugin-lumbre",
  "version": "0.1.0",
  "description": "Lumbre for Alisio: describe a landing page or a small web app, let your Alisio model build it, review every change and preview it live in your browser.",
  "keywords": [
    "alisio-plugin",
    "web-builder",
    "landing-page",
    "vite",
    "nextjs"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GustavoGutierrez/alisio-plugins.git",
    "directory": "packages/plugin-lumbre"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-lumbre",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "presets",
    ".agents",
    "README.md",
    "README.es.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cover.webp",
    "icon.svg"
  ],
  "alisio": {
    "icon": "icon.svg",
    "cover": "cover.webp"
  },
  "peerDependencies": {
    "@alisio/sdk": ">=0.11.6 <0.12.0"
  },
  "dependencies": {
    "npm": "11.9.0"
  },
  "devDependencies": {
    "@alisio/sdk": "0.11.7",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "LUMBRE_INTEGRATION=1 vitest run test/integration.test.ts",
    "prepack": "pnpm build"
  }
}
