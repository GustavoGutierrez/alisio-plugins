{
  "name": "@alisio/plugin-evalua",
  "version": "0.6.1",
  "description": "Guides teachers through a short interview and keeps the teacher profile, workspace and exam numbering for printable school math exams.",
  "keywords": [
    "alisio-plugin",
    "education",
    "math",
    "exams"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio-plugins.git",
    "directory": "packages/plugin-evalua"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-evalua#readme",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "alisio-evalua": "dist/cli.js"
  },
  "files": [
    "dist",
    ".agents",
    "assets",
    "knowledge",
    "templates",
    "README.md",
    "README.es.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cover.webp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@alisio/sdk": ">=0.3.0 <0.7.0"
  },
  "devDependencies": {
    "@alisio/sdk": "0.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
