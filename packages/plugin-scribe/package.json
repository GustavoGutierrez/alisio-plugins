{
  "name": "@alisio/plugin-scribe",
  "version": "0.3.4",
  "description": "Scientific writing studio with agent-assisted LaTeX drafts, revisions, assets and isolated PDF builds.",
  "keywords": [
    "alisio-plugin",
    "latex",
    "scientific-writing",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GustavoGutierrez/alisio-plugins.git",
    "directory": "packages/plugin-scribe"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-scribe",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".agents",
    "README.md",
    "README.es.md",
    "LICENSE",
    "cover.svg",
    "icon.svg",
    "compiler/bundle.zip",
    "compiler/bundle-manifest.json",
    "compiler/linux-x64/tectonic",
    "THIRD_PARTY_NOTICES.md"
  ],
  "alisio": {
    "icon": "icon.svg"
  },
  "peerDependencies": {
    "@alisio/sdk": ">=0.11.6 <0.12.0"
  },
  "devDependencies": {
    "@alisio/sdk": "0.11.6",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "node-tectonic": "1.1.0",
    "pdfjs-dist": "6.5.438"
  }
}
