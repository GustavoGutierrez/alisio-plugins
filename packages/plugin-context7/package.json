    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@alisio/sdk": "^0.4.5"
  },
  "devDependencies": {
    "@alisio/sdk": "0.4.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
