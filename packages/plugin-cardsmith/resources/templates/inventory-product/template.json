{
  "id": "inventory-product",
  "version": 1,
  "family": "dynamic",
  "label": { "es": "Producto de inventario", "en": "Inventory product" },
  "description": {
    "es": "Ficha de producto con precio, estado, SKU y QR de enlace.",
    "en": "Product card with price, status, SKU and link QR."
  },
  "layouts": {
    "square": {
      "slots": [
        {
          "key": "productName",
          "role": "display",
          "box": { "x": 0.08, "y": 0.53, "w": 0.84, "h": 0.13 },
          "align": "left",
          "valign": "top",
          "maxLines": 2,
          "maxSizePct": 5
        },
        {
          "key": "price",
          "role": "display",
          "box": { "x": 0.08, "y": 0.69, "w": 0.35, "h": 0.1 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 6
        },
        {
          "key": "currency",
          "role": "bodyStrong",
          "box": { "x": 0.44, "y": 0.72, "w": 0.12, "h": 0.06 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 3.4
        },
        {
          "key": "sku",
          "role": "body",
          "box": { "x": 0.08, "y": 0.81, "w": 0.5, "h": 0.05 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 2.6
        },
        {
          "key": "status",
          "role": "bodyStrong",
          "box": { "x": 0.58, "y": 0.81, "w": 0.34, "h": 0.05 },
          "align": "right",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 2.6
        },
        {
          "key": "updatedLabel",
          "role": "body",
          "box": { "x": 0.08, "y": 0.88, "w": 0.6, "h": 0.05 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 2.4
        }
      ],
      "imageSlots": [
        { "key": "photo", "box": { "x": 0.08, "y": 0.07, "w": 0.84, "h": 0.42 }, "fit": "cover" }
      ],
      "qr": { "box": { "x": 0.76, "y": 0.62, "w": 0.16, "h": 0.16 } }
    },
    "portrait": {
      "slots": [
        {
          "key": "productName",
          "role": "display",
          "box": { "x": 0.07, "y": 0.49, "w": 0.86, "h": 0.13 },
          "align": "left",
          "valign": "top",
          "maxLines": 2,
          "maxSizePct": 5
        },
        {
          "key": "price",
          "role": "display",
          "box": { "x": 0.07, "y": 0.65, "w": 0.4, "h": 0.09 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 5.5
        },
        {
          "key": "currency",
          "role": "bodyStrong",
          "box": { "x": 0.49, "y": 0.68, "w": 0.12, "h": 0.05 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 3.2
        },
        {
          "key": "sku",
          "role": "body",
          "box": { "x": 0.07, "y": 0.79, "w": 0.5, "h": 0.05 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 2.6
        },
        {
          "key": "status",
          "role": "bodyStrong",
          "box": { "x": 0.07, "y": 0.85, "w": 0.6, "h": 0.05 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 2.6
        },
        {
          "key": "updatedLabel",
          "role": "body",
          "box": { "x": 0.07, "y": 0.91, "w": 0.6, "h": 0.04 },
          "align": "left",
          "valign": "top",
          "maxLines": 1,
          "maxSizePct": 2.3
        }
      ],
      "imageSlots": [
        { "key": "photo", "box": { "x": 0.07, "y": 0.06, "w": 0.86, "h": 0.4 }, "fit": "cover" }
      ],
      "qr": { "box": { "x": 0.74, "y": 0.61, "w": 0.17, "h": 0.136 } }
    }
  },
  "fields": [
    { "key": "productName", "type": "text", "required": true, "maxChars": 80, "overflow": "warn" },
    { "key": "price", "type": "text", "required": true, "maxChars": 30, "overflow": "warn" },
    { "key": "currency", "type": "text", "maxChars": 8, "overflow": "warn" },
    { "key": "sku", "type": "text", "maxChars": 40, "overflow": "warn" },
    { "key": "status", "type": "text", "maxChars": 40, "overflow": "warn" },
    { "key": "updatedLabel", "type": "text", "maxChars": 40, "overflow": "warn" }
  ],
  "defaultPalette": "alisio-ocean",
  "defaultFontPair": "editorial",
  "supports": { "qr": true, "illustration": false, "images": true }
}
