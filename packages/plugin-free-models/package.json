{
  "name": "@alisio/plugin-free-models",
  "version": "0.1.0",
  "description": "Free LLM access for Alisio with minimal setup: Kilo Code works with no account or key, plus free tiers of other OpenAI-compatible services.",
  "keywords": [
    "alisio-plugin",
    "model-provider",
    "free-models",
    "kilo-code",
    "openai-compatible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio-plugins.git",
    "directory": "packages/plugin-free-models"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-free-models#readme",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "cover.svg",
    "icon.svg"
  ],
  "alisio": {
    "icon": "icon.svg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@alisio/sdk": ">=0.9.0 <0.12.0"
  },
  "devDependencies": {
    "@alisio/sdk": "0.11.6",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
