{
  "name": "@alisio/plugin-reportforge",
  "version": "0.1.2",
  "description": "ReportForge for Alisio: turn your data, documents and web pages into editorial HTML/SVG reports and infographics written by your Alisio model, then print them to PDF (one page or many) or download self-contained HTML.",
  "keywords": [
    "alisio-plugin",
    "reports",
    "infographic",
    "html",
    "svg",
    "pdf"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio-plugins.git",
    "directory": "packages/plugin-reportforge"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-reportforge#readme",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".agents",
    "assets",
    "README.md",
    "README.es.md",
    "LICENSE",
    "cover.svg",
    "icon.svg"
  ],
  "alisio": {
    "icon": "icon.svg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "pdfjs-dist": "6.5.438"
  },
  "peerDependencies": {
    "@alisio/sdk": ">=0.11.6 <0.12.0"
  },
  "devDependencies": {
    "@alisio/sdk": "0.11.6",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
