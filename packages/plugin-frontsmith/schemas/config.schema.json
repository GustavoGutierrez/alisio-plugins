{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-frontsmith/schemas/config.schema.json",
  "title": "Frontsmith project configuration",
  "description": "Editor completion for .frontsmith/config.json. The hand-written validator in the plugin is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 512 },
    "schemaVersion": { "const": 1 },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifacts": { "$ref": "#/$defs/relativePath" },
        "sourceRoots": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "themeOutput": { "$ref": "#/$defs/relativePath" },
        "tokenFiles": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["L0", "L1", "L2", "L3"] },
        "mode": { "enum": ["build", "replicate", "refine", "redesign"] }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typecheck": { "$ref": "#/$defs/argv" },
        "lint": { "$ref": "#/$defs/argv" },
        "test": { "$ref": "#/$defs/argv" },
        "testRelated": { "$ref": "#/$defs/argvWithFiles" },
        "e2e": { "$ref": "#/$defs/argv" },
        "build": { "$ref": "#/$defs/argv" }
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/packId" } },
        "disable": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/packId" } },
        "order": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/packId" } }
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/ruleId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "$ref": "#/$defs/severity" },
          "enabled": { "type": "boolean" },
          "justification": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "files": {
            "type": "array",
            "maxItems": 200,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "params": { "type": "object" }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["AA", "AAA"] },
        "operationalMargin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "number", "minimum": 1, "maximum": 21 },
            "nonText": { "type": "number", "minimum": 1, "maximum": 21 }
          }
        }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": { "$ref": "#/$defs/loopbackUrl" },
        "serve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "readyUrl"],
          "properties": {
            "command": { "$ref": "#/$defs/argv" },
            "readyUrl": { "$ref": "#/$defs/loopbackUrl" },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
          }
        },
        "browser": { "enum": ["chromium", "firefox", "webkit"] },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 50 },
        "calibrationPosition": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxImageBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBounces": { "type": "integer", "minimum": 0 },
        "maxRepairRounds": { "type": "integer", "minimum": 0 },
        "maxRemediations": { "type": "integer", "minimum": 0 },
        "maxTaskFiles": { "type": "integer", "minimum": 1 },
        "maxTaskCriteria": { "type": "integer", "minimum": 1 },
        "commandTimeoutMs": { "type": "integer", "minimum": 1000 }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasoning": { "type": "string", "minLength": 1, "maxLength": 200 },
            "standard": { "type": "string", "minLength": 1, "maxLength": 200 },
            "fast": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "attach"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(?!fs-)[a-z][a-z0-9]{1,9}-[a-z0-9-]{2,40}$"
              },
              "attach": {
                "type": "string",
                "pattern": "^(review|audit|build:[a-z][a-z0-9-]{0,30})$"
              },
              "tier": { "enum": ["reasoning", "standard", "fast"] }
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "phase", "command", "report"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
              "phase": { "enum": ["build", "validate"] },
              "command": { "$ref": "#/$defs/argv" },
              "timeoutMs": { "type": "integer", "minimum": 1000 },
              "report": { "enum": ["exit-code", "frontsmith-json"] },
              "required": { "type": "boolean" },
              "severity": { "$ref": "#/$defs/severity" }
            }
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
        },
        "disable": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "$defs": {
    "severity": { "enum": ["blocker", "major", "minor", "nit"] },
    "packId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "ruleId": {
      "type": "string",
      "pattern": "^(FS-[A-Z0-9]{2,6}-[A-Z0-9]{2,5}|(?!FS-)[A-Z][A-Z0-9]{1,7}-[A-Z0-9]{2,6}-[A-Z0-9]{2,5})$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "loopbackUrl": {
      "type": "string",
      "pattern": "^http://(?:127\\.0\\.0\\.1|localhost):(?:[0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])(?:[/?#].*)?$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!.*\\{files\\})[^\\u0000]*$"
      }
    },
    "argvWithFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?:\\{files\\}|(?!.*\\{files\\})[^\\u0000]*)$"
      }
    }
  }
}
