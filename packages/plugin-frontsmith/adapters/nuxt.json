{
  "schemaVersion": 1,
  "id": "nuxt",
  "extends": "vue",
  "detect": { "dependencies": ["nuxt"] },
  "sourceGlobs": ["{app,components,composables,layouts,pages,src}/**/*.{vue,ts,js}"],
  "templates": { "kind": "vue-sfc", "globs": ["**/*.vue"] },
  "componentApi": "none",
  "testGlobs": ["**/*.{spec,test}.{ts,js}", "e2e/**/*.ts"],
  "packs": ["fs-vue"],
  "commands": { "testRelated": null }
}
