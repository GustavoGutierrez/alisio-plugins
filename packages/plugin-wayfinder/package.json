{
  "name": "@alisio/plugin-wayfinder",
  "version": "0.2.2",
  "description": "Coordinates a resumable specification-driven development workflow by delegating bounded phases to fresh Alisio child sessions and persisting validated artifacts in the workspace.",
  "keywords": [
    "alisio-plugin",
    "specification-driven-development",
    "workflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio-plugins.git",
    "directory": "packages/plugin-wayfinder"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-wayfinder#readme",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".agents",
    "assets",
    "README.md",
    "LICENSE",
    "cover.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@alisio/sdk": "^0.5.1"
  },
  "devDependencies": {
    "@alisio/sdk": "0.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
