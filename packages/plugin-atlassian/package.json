{
  "name": "@alisio/plugin-atlassian",
  "version": "0.1.0",
  "description": "Read-first Jira and Confluence Cloud tools for Alisio with strict environment configuration, opt-in writes, and untrusted-content framing.",
  "keywords": [
    "alisio-plugin",
    "atlassian",
    "jira",
    "confluence",
    "tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio-plugins.git",
    "directory": "packages/plugin-atlassian"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins/tree/main/packages/plugin-atlassian#readme",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "alisio-atlassian": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".agents",
    "README.md",
    "LICENSE",
    "cover.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@alisio/sdk": ">=0.1.0-alpha.10 <0.2.0"
  },
  "devDependencies": {
    "@alisio/sdk": "0.1.0-alpha.11",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
