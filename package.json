{
  "name": "alisio-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "author": {
    "name": "Gustavo Gutiérrez",
    "url": "https://github.com/GustavoGutierrez"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGutierrez/alisio-plugins.git"
  },
  "homepage": "https://github.com/GustavoGutierrez/alisio-plugins#readme",
  "bugs": {
    "url": "https://github.com/GustavoGutierrez/alisio-plugins/issues"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "pack:check": "node scripts/pack-check.mjs",
    "leak:check": "node scripts/leak-check.mjs",
    "diagrams": "node scripts/render-diagrams.mjs --all",
    "diagrams:check": "node scripts/render-diagrams.mjs --all --check",
    "docs:dev": "vitepress dev site",
    "docs:scan": "node scripts/scan-plugins.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:build": "vitepress build site",
    "check": "pnpm lint && pnpm leak:check && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check && pnpm docs:check && pnpm docs:build",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-versions.mjs",
    "release:changesets": "pnpm check && changeset publish",
    "release": "pnpm release:changesets",
    "bump-one": "node scripts/bump-one.mjs",
    "publish-all": "node scripts/publish-all.mjs",
    "publish-one": "node scripts/publish-one.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitest": "5.0.1",
    "vue": "3.5.43"
  }
}
