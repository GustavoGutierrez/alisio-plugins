flowchart TD
  question(["Question + ticked sources"]) --> vector["Vector search: top 20 (api.semantic.trySearch)"]
  question --> keyword["Keyword search: FTS5 BM25 top 20"]
  vector -->|"unavailable: skip"| fuse
  vector --> fuse["Reciprocal Rank Fusion k=60, keep top 8"]
